rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read & write for user profiles, direct messages, and community circle posts
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /direct_messages/{messageId} {
      allow read, write: if true;
    }
    
    match /circle_messages/{messageId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
